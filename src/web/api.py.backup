@api_router.get('/api/clients')
async def get_clients():
    """Get list of all clients"""
    # Enforce sheet-only mode if forced
    if _force_sheet_mode() and not _get_spreadsheet_id():
        raise HTTPException(status_code=400, detail='Operation not allowed: FORCE_SHEET_MODE enabled but spreadsheet not configured')
    return MOCK_CLIENTS


@api_router.post('/api/clients', status_code=201)
async def create_client(client: Client):
    """Create a new client"""
    if _force_sheet_mode() and not _get_spreadsheet_id():
        raise HTTPException(status_code=400, detail='Operation not allowed: FORCE_SHEET_MODE enabled but spreadsheet not configured')
    new_client = client.dict()
    new_client['id'] = len(MOCK_CLIENTS) + 1
    MOCK_CLIENTS.append(new_client)
    return new_client


