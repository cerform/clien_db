@api_router.get('/api/endpoints')
async def list_endpoints(request: Request):
	"""Return a simplified list of API routes available in the current app.

	Each object contains: path, methods, name, summary, description, tags
	"""
	routes = []
	openapi = None
	try:
		openapi = request.app.openapi()
	except Exception:
		openapi = None
	for r in request.app.routes:
		# Only include standard routes (exclude static or non-API resources)
		try:
			path = getattr(r, 'path', None) or getattr(r, 'path_regex', None)
			if not path:
				continue
			# Exclude static and OpenAPI docs resources
			if isinstance(path, str) and (path.startswith('/static') or path.startswith('/openapi') or path.startswith('/docs') or path.startswith('/redoc') or path == '/api/endpoints'):
				continue
			name = getattr(r, 'name', None)
			methods = list(getattr(r, 'methods', []) or [])
			tags = list(getattr(r, 'tags', []) or [])
			summary = getattr(r, 'summary', '') or ''
			# If summary is not set, try to use docstring
			if not summary and hasattr(r, 'endpoint') and getattr(r.endpoint, '__doc__', None):
				summary = r.endpoint.__doc__.strip().splitlines()[0][:200]
			operation = {}
			if openapi:
				paths = openapi.get('paths', {})
				meta = paths.get(path) or paths.get(path.rstrip('/')) or None
				if meta and methods:
					for m in methods:
						m_lower = m.lower()
						if m_lower in meta:
							op = meta[m_lower]
							operation[m] = {
								'summary': op.get('summary'),
								'description': op.get('description'),
								'parameters': op.get('parameters', []),
								'requestBody': op.get('requestBody', {}),
								'responses': op.get('responses', {})
							}
			routes.append({
				'path': path,
				'methods': methods,
				'name': name,
				'summary': summary,
				'tags': tags,
				'operations': operation,
			})
		except Exception:
			continue
	return routes

