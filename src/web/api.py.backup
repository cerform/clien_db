# Mock bookings
def generate_mock_bookings():
    statuses = ["confirmed", "pending", "completed", "cancelled"]
    bookings = []
    for i in range(1, 26):
        booking_date = date.today() + timedelta(days=random.randint(-10, 30))
        bookings.append({
            "id": i,
            "client_id": random.randint(1, 5),
            "client_name": random.choice(MOCK_CLIENTS)["name"],
            "master_id": random.randint(1, 5),
            "master_name": random.choice(MOCK_MASTERS)["name"],
            "service_id": random.randint(1, 5),
            "service_name": random.choice(MOCK_SERVICES)["name"],
            "booking_date": booking_date.isoformat(),
            "start_time": f"{random.randint(9, 18)}:00",
            "end_time": f"{random.randint(10, 20)}:00",
            "status": random.choice(statuses),
            "notes": "Клиент хочет эскиз в стиле минимализм",
            "created_at": (booking_date - timedelta(days=random.randint(1, 5))).isoformat()
        })
    return bookings

MOCK_BOOKINGS = generate_mock_bookings()

