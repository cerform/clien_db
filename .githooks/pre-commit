#!/bin/bash
# Simple pre-commit hook to catch obvious secret patterns in staged files
set -euo pipefail

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "${STAGED_FILES}" ]; then
    exit 0
fi

PATTERNS=("sk-[A-Za-z0-9_-]{10,}" "[0-9]{8,}:[A-Za-z0-9_-]{20,}" "OPENAI_API_KEY" "BOT_TOKEN" "CLOUDSQL_PASSWORD")

for f in ${STAGED_FILES}; do
    # only inspect files that exist (skip deletions)
    if git ls-files --error-unmatch "$f" >/dev/null 2>&1 || git show :"$f" >/dev/null 2>&1; then
        CONTENT=$(git show :"$f" 2>/dev/null || true)
        for p in "${PATTERNS[@]}"; do
            if echo "$CONTENT" | grep -E "$p" -q; then
                echo ""
                echo "[pre-commit] Potential secret detected in staged file: $f"
                echo "Pattern: $p"
                echo "Please remove secrets and store them in Secret Manager or .env (which should be gitignored)."
                echo "Aborting commit."
                exit 1
            fi
        done
    fi
done

exit 0
