# Local env example for docker-compose
BOT_TOKEN=
OPENAI_API_KEY=
CLOUDSQL_PASSWORD=password
SPREADSHEET_ID=
SERVICE_URL=http://localhost:8081
ADMIN_USER_IDS=438407739,457343487
DEFAULT_TIMEZONE=Asia/Jerusalem
PORT=8080
### Example environment file for Tattoo Bot
# Copy to .env and fill the values with your actual secrets

TELEGRAM_BOT_TOKEN=telegram_bot_token_here
OPENAI_API_KEY=openai_api_key_here
SPREADSHEET_ID=google_spreadsheet_id_here
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
DEFAULT_TIMEZONE=Asia/Jerusalem
ADMIN_USER_IDS=438407739,457343487
ENV=production
USE_WEBHOOK=true
WEBHOOK_URL=https://your-run-service-url/webhook/telegram
PORT=8080

# Cloud SQL / Postgres (local defaults shown; set for prod via Cloud Run)
CLOUDSQL_USER=tattoo_user
CLOUDSQL_PASSWORD=strong_password_here
CLOUDSQL_DB=tattoo_salon
CLOUDSQL_HOST=127.0.0.1
CLOUDSQL_PORT=5432
CLOUDSQL_CONNECTION_NAME=tattoo-480007:us-central1:tattoo-db
CLOUD_RUN_ENV=false
DB_SOCKET_DIR=/cloudsql

# Alternate: set DATABASE_URL for direct Postgres URL or Secret Manager
# DATABASE_URL=postgresql+psycopg2://user:password@/tattoo_salon?host=/cloudsql/tattoo-480007:us-central1:tattoo-db
# ==============================================================================
# Tattoo Appointment Bot Configuration
# Copy this to .env and fill in your values
# ==============================================================================

# ==============================================================================
# TELEGRAM BOT
# ==============================================================================
# Get token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
BOT_TOKEN=your_bot_token_here

# Optional: Use webhook instead of polling (requires HTTPS domain)
USE_WEBHOOK=true
WEBHOOK_URL=https://your-cloud-run-url.run.app/telegram/webhook
WEBHOOK_SECRET=your_random_secret_token_here

# ==============================================================================
# GOOGLE API CONFIGURATION
# ==============================================================================

# Download credentials.json from Google Cloud Console (Desktop OAuth app)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# Create spreadsheet: python3 scripts/create_google_sheets_structure.py
# Then paste the ID here (from URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit)
SPREADSHEET_ID=your_spreadsheet_id_here

# Google Calendar ID for master schedule
# Get from Calendar settings or use 'primary' for main calendar
MASTER_CALENDAR_ID=your_calendar_id_here

# ==============================================================================
# OPENAI / LLM CONFIGURATION
# ==============================================================================

# Get API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# BOT CONFIGURATION
# ==============================================================================

# Timezone for all dates (default: Asia/Jerusalem for tattoo studio in Israel)
# Available: Europe/Moscow, America/New_York, etc.
DEFAULT_TIMEZONE=Asia/Jerusalem

# Your admin Telegram IDs (comma-separated, no spaces)
# Get your ID: send /getid to @userinfobot or /start to @userinfobot
ADMIN_USER_IDS=123456789,987654321

# Environment (development/production)
ENV=development

# Server port
PORT=8080

# Default booking slot duration in minutes
DEFAULT_SLOT_DURATION=120

# ==============================================================================
# CLOUD RUN / PRODUCTION CONFIGURATION
# ==============================================================================

# Cloud Run environment detection (set automatically by Cloud Run)
# CLOUD_RUN_ENV=true
# K_SERVICE=tattoo-bot

# Google Cloud Project ID
GCP_PROJECT_ID=your-gcp-project-id

# Cloud SQL Configuration (for Cloud Run deployment)
CLOUDSQL_CONNECTION_NAME=project-id:region:instance-name
CLOUDSQL_USER=root
CLOUDSQL_PASSWORD=your_cloudsql_password_here
CLOUDSQL_DB=admin_messages
DB_SOCKET_DIR=/cloudsql

# Force sheet-backed mode (no mock data fallbacks)
FORCE_SHEET_MODE=false

# ==============================================================================
# OPTIONAL: MONITORING & LOGGING
# ==============================================================================

# Sentry for error tracking (optional)
# Get DSN from https://sentry.io
# SENTRY_DSN=https://key@sentry.io/project

# Enable Google Cloud Logging (for Cloud Run)
# ENABLE_CLOUD_LOGGING=true

# Redis for sessions (optional, for production)
# REDIS_URL=redis://localhost:6379

# ==============================================================================
# SECURITY NOTES
# ==============================================================================
#
# 1. NEVER commit .env file to git (it's in .gitignore)
# 2. Use Google Secret Manager for production secrets
# 3. Rotate tokens regularly
# 4. Use different tokens for dev/staging/production
#
# ==============================================================================
