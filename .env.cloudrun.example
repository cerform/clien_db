# Cloud Run Environment Variables Example
# Copy this to Secret Manager or set as environment variables in Cloud Run

# Telegram Bot
BOT_TOKEN=your_bot_token_here

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud
PROJECT_ID=tattoo-480007
REGION=us-central1
SPREADSHEET_ID=your_spreadsheet_id_here

# Cloud SQL Configuration
CLOUDSQL_CONNECTION_NAME=tattoo-480007:us-central1:tattoo-bot-db
CLOUDSQL_USER=root
CLOUDSQL_PASSWORD=your_cloudsql_password_here
CLOUDSQL_DB=admin_messages
DB_SOCKET_DIR=/cloudsql

# Cloud Run specific
CLOUD_RUN_ENV=true
K_SERVICE=tattoo-bot
PORT=8080

# Webhook Configuration
WEBHOOK_PATH=/webhook/telegram

# Admin Configuration
ADMIN_IDS=your_telegram_admin_id_here
